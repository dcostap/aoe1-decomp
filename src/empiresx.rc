// Resources for the Rise of Rome executable.
// The build extracts empiresx.ico from the retail EMPIRES.EXE in runtime/.

#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

APPICON ICON "empiresx.ico"

1 VERSIONINFO
 FILEVERSION 0,2,2,703
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Microsoft Corporation\0"
            VALUE "FileDescription", "Age of Empires, the Rise of Rome\0"
            VALUE "FileVersion", "00.03.01.0717\0"
            VALUE "InternalName", "EMPIRES\0"
            VALUE "LegalCopyright", "Copyright \251 Microsoft Corp. 1998\0"
            VALUE "OriginalFilename", "EMPIRESX.EXE\0"
            VALUE "ProductName", "Age of Empires, the Rise of Rome\0"
            VALUE "ProductVersion", "1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
