diff --git a/src/taistrmd.cpp b/src/taistrmd.cpp
index 553fa3813..1a7f23d23 100644
--- a/src/taistrmd.cpp
+++ b/src/taistrmd.cpp
@@ -15,2 +15,36 @@
+// This TU's original rule loops expand the direct-allocation add donor.
+// Keep that proven specialization while the shared candidate uses resize.
+template <>
+inline int ManagedArray<int>::add(int val)
+{
+    int i;
+
+    for (i = 0; i < this->numberValue; i++) {
+        if (i >= this->maximumSizeValue)
+            break;
+        if (this->value[i] == val)
+            return 0;
+    }
+    if (this->numberValue > this->maximumSizeValue - 1) {
+        int newSize = this->numberValue + 1;
+        int* newValue = (int*)operator_new(newSize * sizeof(int));
+        if (newValue != 0) {
+            int j;
+            for (j = 0; j < this->maximumSizeValue; j++) {
+                if (j >= newSize)
+                    break;
+                newValue[j] = this->value[j];
+            }
+            operator_delete(this->value);
+            this->value = newValue;
+            this->maximumSizeValue = newSize;
+        }
+    }
+    this->value[this->numberValue] = val;
+    this->numberValue++;
+    return 1;
+}
