// TEMPLATE vc5_assign_temp: direct expression use vs named temp lifetime.
// Added because VC5 liveness/register basins often change when a value is named,
// declared early, assigned late, const, or register.
// Args: expr. Optional args: type, tmp. Slots: before, use.
@choice {{axis}}
@case direct_use
{{slot:use}}
@case init_temp_then_use
{{type}} {{tmp}} = {{expr}};
{{slot:use}}
@case declare_then_assign_then_use
{{type}} {{tmp}};
{{tmp}} = {{expr}};
{{slot:use}}
@case early_decl_late_assign
{{type}} {{tmp}};
{{slot:before}}
{{tmp}} = {{expr}};
{{slot:use}}
@case const_temp_then_use
const {{type}} {{tmp}} = {{expr}};
{{slot:use}}
@case register_temp_then_use
register {{type}} {{tmp}} = {{expr}};
{{slot:use}}
@endchoice
